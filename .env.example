# zbay-bot settings. Copy this file to .env and fill it in.
#
#   .env is ignored by git. This file is not: never put a real value in here.
#
# The bot reads .env when it starts, from the folder it is run in or from the top of
# this repo. Anything already set in the real environment wins over this file, and a
# command-line flag wins over both.
#
# Values are taken as written: no quotes needed, and a backslash is just a backslash,
# so a Windows path goes in as it is.

# ---------------------------------------------------------------------------
# The bot
# ---------------------------------------------------------------------------

# The bot's token, from the Bot page of your application in the Discord developer
# portal. This is the one real secret in the file.
ZBAY_DISCORD_TOKEN=

# Where pairings and account links are kept. Created if it isn't there.
ZBAY_DB=zbay.sqlite

# The setup page's address. /zbay setup shows it to admins. Optional.
ZBAY_SETUP_URL=

# ---------------------------------------------------------------------------
# Hosted: one bot for many game servers. Relays connect to this address.
# ---------------------------------------------------------------------------

# Leave it on 127.0.0.1 behind a reverse proxy or a tunnel that terminates TLS.
ZBAY_HOST=127.0.0.1
ZBAY_PORT=8080

# ---------------------------------------------------------------------------
# Local: one game server, on the machine it runs on. No relay and no address:
# the bot reads the game's bridge folder itself.
# ---------------------------------------------------------------------------

# true to run this way. The two below it are then required.
ZBAY_LOCAL=false

# The game server's Zomboid/Lua/zBay folder.
# ZBAY_DIR=C:\Users\you\Zomboid\Lua\zBay
ZBAY_DIR=

# The id of the one Discord server this copy is for. Turn on Developer Mode in
# Discord, right-click the server, Copy Server ID.
ZBAY_GUILD=

# Seconds between looks at the bridge folder.
ZBAY_INTERVAL=2

# ---------------------------------------------------------------------------
# The relay (relay/zbay_relay.py). It does not read this file: it is handed out
# on its own. Set this in the environment of whatever runs it.
# ---------------------------------------------------------------------------

# The game server's RCONPassword, only when the relay is started with --rcon-port.
# ZBAY_RCON_PASSWORD=
