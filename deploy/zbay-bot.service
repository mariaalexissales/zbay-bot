# zBay's Discord bot as a systemd service, for a Linux machine that stays on.
#
# It expects the repo at /opt/zbay-bot with a venv in it at .venv, the settings in
# /opt/zbay-bot/.env, and a user called zbay that owns the folder. The README's
# "Hosting it" section has the steps. Then:
#
#   sudo cp deploy/zbay-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zbay-bot
#   journalctl -u zbay-bot -f

[Unit]
Description=zBay Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=zbay
WorkingDirectory=/opt/zbay-bot/service
ExecStart=/opt/zbay-bot/.venv/bin/python -m zbay_service
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=15

# it writes its database and its place in the game's files, both in its working
# folder, and nothing else on the machine.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zbay-bot/service

[Install]
WantedBy=multi-user.target
